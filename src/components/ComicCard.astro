---
interface Props {
	slug: string;
	title: string;
	description: string;
	coverImage: string;
	genre?: string[];
	status?: 'ongoing' | 'completed';
	featured?: boolean;
	chapterCount?: number;
	pubDate?: Date;
	/** Show as a large featured card */
	featured_display?: boolean;
}

const {
	slug,
	title,
	description,
	coverImage,
	genre = [],
	status = 'ongoing',
	chapterCount = 0,
	pubDate,
	featured_display = false,
} = Astro.props;

const statusLabel = status === 'ongoing' ? '🟢 Ongoing' : '✅ Completed';
const href = `/comics/${slug}`;
---

<article class:list={['comic-card', { 'comic-card--featured': featured_display }]}>
	<a href={href} class="cover-link" tabindex="-1" aria-hidden="true">
		<div class="cover">
			<img
				src={coverImage}
				alt={`Cover art for ${title}`}
				loading="lazy"
				decoding="async"
				width={featured_display ? 600 : 300}
				height={featured_display ? 400 : 200}
			/>
			<span class={`status-badge ${status}`}>{statusLabel}</span>
		</div>
	</a>

	<div class="info">
		{genre.length > 0 && (
			<div class="genres">
				{genre.map(g => <span class="badge badge-purple">{g}</span>)}
			</div>
		)}

		<h3><a href={href}>{title}</a></h3>
		<p class="desc">{description}</p>

		<div class="meta">
			{chapterCount > 0 && (
				<span class="chapter-count">📖 {chapterCount} chapter{chapterCount !== 1 ? 's' : ''}</span>
			)}
			{pubDate && (
				<time datetime={pubDate.toISOString()} class="pub-date">
					{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
				</time>
			)}
		</div>

		<a href={href} class="btn btn-primary btn-sm read-btn">
			Read Now →
		</a>
	</div>
</article>

<style>
.comic-card {
	display: flex;
	flex-direction: column;
	background: var(--surface);
	border-radius: var(--radius-lg);
	border: 2px solid var(--border);
	box-shadow: var(--shadow);
	overflow: hidden;
	transition: transform .2s, box-shadow .2s;
}
.comic-card:hover {
	transform: translateY(-4px);
	box-shadow: var(--shadow-lg);
}

.cover-link { display: block; }

.cover {
	position: relative;
	aspect-ratio: 3/2;
	overflow: hidden;
	background: var(--primary-light);
}
.cover img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	border-radius: 0;
	transition: transform .3s;
}
.comic-card:hover .cover img { transform: scale(1.05); }

.status-badge {
	position: absolute;
	top: .75rem;
	right: .75rem;
	padding: .2rem .65rem;
	border-radius: 999px;
	font-size: .78rem;
	font-weight: 700;
	backdrop-filter: blur(4px);
}
.status-badge.ongoing   { background: rgba(255,255,255,.9); color: var(--success); }
.status-badge.completed { background: rgba(255,255,255,.9); color: var(--secondary); }

.info {
	padding: 1.1rem 1.25rem 1.25rem;
	display: flex;
	flex-direction: column;
	gap: .6rem;
	flex: 1;
}

.genres {
	display: flex;
	flex-wrap: wrap;
	gap: .35rem;
}

.info h3 {
	margin: 0;
	font-size: 1.1rem;
}
.info h3 a {
	color: var(--text);
	text-decoration: none;
}
.info h3 a:hover { color: var(--secondary); }

.desc {
	font-size: .9rem;
	color: var(--text-muted);
	margin: 0;
	display: -webkit-box;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.meta {
	display: flex;
	align-items: center;
	gap: .85rem;
	font-size: .82rem;
	color: var(--text-muted);
	flex-wrap: wrap;
}

.read-btn { margin-top: auto; align-self: flex-start; }

/* Featured variant */
.comic-card--featured { flex-direction: row; }
.comic-card--featured .cover {
	width: 45%;
	flex-shrink: 0;
	aspect-ratio: unset;
	min-height: 260px;
}
.comic-card--featured .info { padding: 1.5rem; }
.comic-card--featured .info h3 { font-size: 1.4rem; }
.comic-card--featured .desc  { -webkit-line-clamp: 5; }

@media (max-width: 640px) {
	.comic-card--featured { flex-direction: column; }
	.comic-card--featured .cover { width: 100%; min-height: unset; }
}
</style>
