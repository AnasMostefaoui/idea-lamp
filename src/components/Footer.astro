---
import { SITE_TITLE, CREATOR_NAME } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" class="logo-link" aria-label="Home">
					<span aria-hidden="true">💡</span> {SITE_TITLE}
				</a>
				<p class="tagline">Hand-drawn comics by {CREATOR_NAME} · Age 8 · Future legend 🌟</p>
			</div>

			<nav aria-label="Footer navigation">
				<div class="footer-col">
					<h3>Explore</h3>
					<a href="/comics">All Comics</a>
					<a href="/about">About Ilyes</a>
					<a href="/fan-mail">Fan Mail</a>
				</div>
				<div class="footer-col">
					<h3>Discover</h3>
					<a href="/rss.xml">RSS Feed</a>
					<a href="/sitemap-index.xml">Sitemap</a>
				</div>
			</nav>
		</div>

		<div class="footer-bottom">
			<p>&copy; {year} {SITE_TITLE}. All comics are original creations by {CREATOR_NAME}.</p>
			<p class="love">Made with 💛 and lots of imagination</p>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--text);
		color: #CBD5E1;
		padding: 3rem 0 1.5rem;
		margin-top: 4rem;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.footer-top {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.footer-brand { max-width: 320px; }

	.logo-link {
		display: inline-flex;
		align-items: center;
		gap: .4rem;
		font-family: "Bangers", "Atkinson", sans-serif;
		font-size: 1.5rem;
		letter-spacing: .05em;
		color: var(--primary);
		text-decoration: none;
	}
	.logo-link:hover { text-decoration: none; opacity: .85; }

	.tagline {
		margin-top: .5rem;
		font-size: .9rem;
		line-height: 1.5;
		color: #94A3B8;
	}

	nav {
		display: flex;
		gap: 3rem;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: .4rem;
	}
	.footer-col h3 {
		font-size: .8rem;
		text-transform: uppercase;
		letter-spacing: .12em;
		color: #64748B;
		margin-bottom: .4rem;
	}
	.footer-col a {
		color: #CBD5E1;
		font-size: .95rem;
		text-decoration: none;
		transition: color .15s;
	}
	.footer-col a:hover { color: var(--primary); }

	.footer-bottom {
		border-top: 1px solid #334155;
		padding-top: 1.25rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: .5rem;
		font-size: .85rem;
		color: #64748B;
	}
	.love { color: #64748B; }

	@media (max-width: 720px) {
		.footer-top { flex-direction: column; }
		.footer-bottom { flex-direction: column; text-align: center; }
	}
</style>

