---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	pageType?: 'WebPage' | 'ComicStory' | 'Article' | 'ContactPage' | 'AboutPage';
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
	/** Remove default container padding (e.g. for chapter reader) */
	fullWidth?: boolean;
}

const { fullWidth = false, ...headProps } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...headProps} />
	</head>
	<body>
		<Header />
		<main class:list={[{ 'full-width': fullWidth }]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		min-height: 60vh;
	}
	main:not(.full-width) {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}
</style>
