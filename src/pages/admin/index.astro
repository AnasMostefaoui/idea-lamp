---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const env = (Astro.locals as App.Locals).runtime?.env as (Env & { ADMIN_PASSWORD?: string }) | undefined;
const adminPassword = env?.ADMIN_PASSWORD;

// Check if already authenticated
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionToken = cookie.match(/admin_session=([^;]+)/)?.[1];

// Derive expected token (HMAC-SHA256 of password, base64)
async function makeToken(password: string): Promise<string> {
	const key = await crypto.subtle.importKey(
		'raw',
		new TextEncoder().encode(password),
		{ name: 'HMAC', hash: 'SHA-256' },
		false,
		['sign']
	);
	const sig = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode('admin-session-v1'));
	return btoa(String.fromCharCode(...new Uint8Array(sig)));
}

let isAuthenticated = false;
if (adminPassword && sessionToken) {
	const expected = await makeToken(adminPassword);
	isAuthenticated = sessionToken === expected;
}

if (isAuthenticated) {
	return Astro.redirect('/admin/messages');
}

// Handle login form submission
let loginError = '';
if (Astro.request.method === 'POST') {
	const fd = await Astro.request.formData().catch(() => null);
	const submitted = ((fd?.get('password') as string | null) ?? '').trim();

	if (!adminPassword) {
		loginError = 'Admin password not configured. Set the ADMIN_PASSWORD environment variable.';
	} else if (!submitted) {
		loginError = 'Please enter the password.';
	} else {
		// Constant-time comparison via HMAC
		const submittedToken = await makeToken(submitted);
		const expectedToken  = await makeToken(adminPassword);
		if (submittedToken === expectedToken) {
			return new Response(null, {
				status: 302,
				headers: {
					Location: '/admin/messages',
					'Set-Cookie': `admin_session=${expectedToken}; HttpOnly; SameSite=Strict; Path=/admin; Max-Age=86400`,
				},
			});
		} else {
			loginError = 'Incorrect password.';
		}
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Admin Login" description="Admin login for Idea Lamp Ilyes" noindex={true} />
	</head>
	<body>
		<Header />
		<main class="container">
			<div class="login-wrap">
				<h1>🔐 Admin Login</h1>
				<p class="sub">Access the fan messages dashboard.</p>

				{loginError && <div class="alert alert-danger">{loginError}</div>}

				<form method="POST" class="login-form">
					<div class="field">
						<label for="password">Password</label>
						<input
							type="password"
							id="password"
							name="password"
							required
							autocomplete="current-password"
							placeholder="Enter admin password"
						/>
					</div>
					<button type="submit" class="btn btn-primary submit-btn">Login →</button>
				</form>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
.container {
	max-width: 1200px;
	margin: 0 auto;
	padding: 2rem 1.5rem;
}
.login-wrap {
	max-width: 420px;
	margin: 4rem auto;
	background: var(--surface);
	border: 2px solid var(--border);
	border-radius: var(--radius-lg);
	padding: 2.5rem;
	box-shadow: var(--shadow);
}
.login-wrap h1 { margin-bottom: .4rem; }
.sub { color: var(--text-muted); margin-bottom: 1.5rem; }
.field { margin-bottom: 1.25rem; }
.submit-btn { width: 100%; justify-content: center; }
</style>
