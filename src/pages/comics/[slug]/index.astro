---
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const comics = await getCollection('comics');
	const chapters = await getCollection('chapters');

	return comics.map(comic => ({
		params: { slug: comic.id },
		props: {
			comic,
			chapters: chapters
				.filter(c => c.data.comicSlug === comic.id)
				.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber),
		},
	}));
}

const { comic, chapters } = Astro.props;
const { title, description, coverImage, genre, status, pubDate, updatedDate } = comic.data;

const slug = comic.id;
const firstChapter = chapters[0];
const latestChapter = chapters[chapters.length - 1];

const comicJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ComicSeries',
	name: title,
	description,
	image: coverImage,
	url: `${Astro.site}comics/${slug}`,
	author: { '@type': 'Person', name: 'Ilyes' },
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	genre,
	numberOfItems: chapters.length,
};
---

<BaseLayout
	title={title}
	description={description}
	image={coverImage}
	pageType="ComicStory"
	jsonLd={comicJsonLd}
>
	<Breadcrumbs crumbs={[
		{ label: 'Home', href: '/' },
		{ label: 'Comics', href: '/comics' },
		{ label: title },
	]} />

	<div class="comic-detail">
		<!-- Cover -->
		<aside class="cover-col">
			<img
				src={coverImage}
				alt={`Cover art for ${title}`}
				class="cover-img"
				width={400}
				height={560}
			/>
			{firstChapter && (
				<a
					href={`/comics/${slug}/${firstChapter.id.split('/').pop()}`}
					class="btn btn-primary start-btn"
				>
					▶ Start Reading
				</a>
			)}
			{latestChapter && chapters.length > 1 && (
				<a
					href={`/comics/${slug}/${latestChapter.id.split('/').pop()}`}
					class="btn btn-outline latest-btn"
				>
					⏭ Latest Chapter
				</a>
			)}
		</aside>

		<!-- Info -->
		<div class="info-col">
			<h1>{title}</h1>

			<div class="meta-row">
				<span class={`badge ${status === 'completed' ? 'badge-green' : 'badge-purple'}`}>
					{status === 'completed' ? '✅ Completed' : '🟢 Ongoing'}
				</span>
				{genre?.map(g => <span class="badge">{g}</span>)}
			</div>

			<p class="description">{description}</p>

			<div class="stats">
				<div class="stat">
					<span class="stat-value">{chapters.length}</span>
					<span class="stat-label">Chapter{chapters.length !== 1 ? 's' : ''}</span>
				</div>
				<div class="stat">
					<span class="stat-value">
						<FormattedDate date={pubDate} />
					</span>
					<span class="stat-label">Published</span>
				</div>
				{updatedDate && (
					<div class="stat">
						<span class="stat-value"><FormattedDate date={updatedDate} /></span>
						<span class="stat-label">Updated</span>
					</div>
				)}
			</div>

			<!-- Chapter list -->
			<div class="chapter-list">
				<h2>📖 Chapters</h2>
				{chapters.length === 0 ? (
					<p class="empty">Chapters coming soon — stay tuned!</p>
				) : (
					<ol>
						{chapters.map(ch => {
							const chapterSlug = ch.id.split('/').pop() ?? '';
							return (
								<li>
									<a href={`/comics/${slug}/${chapterSlug}`} class="chapter-link">
										<span class="ch-num">Ch. {ch.data.chapterNumber}</span>
										<span class="ch-title">{ch.data.title}</span>
										<span class="ch-pages">{ch.data.pages.length} pages</span>
										<time class="ch-date" datetime={ch.data.pubDate.toISOString()}>
											<FormattedDate date={ch.data.pubDate} />
										</time>
										<span class="ch-arrow">→</span>
									</a>
								</li>
							);
						})}
					</ol>
				)}
			</div>
		</div>
	</div>
</BaseLayout>

<style>
.comic-detail {
	display: flex;
	gap: 2.5rem;
	align-items: flex-start;
	flex-wrap: wrap;
}

.cover-col {
	flex-shrink: 0;
	width: 260px;
	display: flex;
	flex-direction: column;
	gap: .75rem;
}
.cover-img {
	width: 100%;
	aspect-ratio: 5/7;
	object-fit: cover;
	border-radius: var(--radius-lg);
	border: 3px solid var(--border);
	box-shadow: var(--shadow-lg);
}
.start-btn, .latest-btn { width: 100%; justify-content: center; }

.info-col { flex: 1; min-width: 280px; }
.info-col h1 { margin-bottom: .75rem; }

.meta-row { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }

.description {
	font-size: 1.05rem;
	color: var(--text-muted);
	margin-bottom: 1.75rem;
	line-height: 1.7;
}

.stats {
	display: flex;
	gap: 1.5rem;
	margin-bottom: 2rem;
	flex-wrap: wrap;
}
.stat {
	display: flex;
	flex-direction: column;
	gap: .15rem;
}
.stat-value { font-weight: 800; font-size: 1.1rem; }
.stat-label { font-size: .8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }

.chapter-list h2 { margin-bottom: 1rem; }

.chapter-list ol {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: .5rem;
}

.chapter-link {
	display: flex;
	align-items: center;
	gap: .75rem;
	padding: .9rem 1.1rem;
	background: var(--surface);
	border: 2px solid var(--border);
	border-radius: var(--radius);
	text-decoration: none;
	color: var(--text);
	transition: border-color .15s, background .15s;
	flex-wrap: wrap;
}
.chapter-link:hover {
	border-color: var(--secondary);
	background: var(--surface-alt);
	text-decoration: none;
}

.ch-num  { font-weight: 800; color: var(--secondary); min-width: 3rem; }
.ch-title{ font-weight: 700; flex: 1; }
.ch-pages{ font-size: .82rem; color: var(--text-muted); }
.ch-date { font-size: .82rem; color: var(--text-light); }
.ch-arrow{ margin-left: auto; color: var(--secondary); }

.empty { color: var(--text-muted); }

@media (max-width: 640px) {
	.cover-col { width: 100%; max-width: 280px; margin: 0 auto; }
}
</style>
